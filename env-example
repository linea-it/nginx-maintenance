# Copie para .env na mesma pasta do docker-compose.yml.
# O compose lê .env ao subir; html/content.json guarda os textos.

# Porta no servidor. O proxy das aplicações aponta para ela.
HTTP_PORT=7777

# 127.0.0.1 se só o proxy neste host precisar alcançar a página.
HTTP_BIND=0.0.0.0

# Mude o nome quando houver uma instância por aplicação.
CONTAINER_NAME=nginx-maintenance
